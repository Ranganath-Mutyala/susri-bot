// Cloudflare Workers configuration (used by OpenNext + Wrangler).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisecompare-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Keep variables you set in the Cloudflare dashboard when deploying.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wisecompare-db",
      // Paste the Database ID from Cloudflare dashboard → Storage & Databases → D1 → wisecompare-db
      "database_id": "c783398e-e0fc-474b-b4e5-ca2c3aa92be0",
      "migrations_dir": "migrations"
    }
  ]
}
