# Production settings — copy to .env on the server and fill in.

# Absolute path, OUTSIDE the code folder, so deploys never touch your data.
DATABASE_URL="file:/var/lib/clearcompare/prod.db"

ADMIN_EMAIL="you@yourdomain.com"
# At least 12 characters. Use a password manager.
ADMIN_PASSWORD="change-me-to-a-long-password"
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-with-output-of-openssl-rand"

NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
