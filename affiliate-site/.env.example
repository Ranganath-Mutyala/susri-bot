# Database (SQLite file, relative to prisma/). Swap to postgresql://... and change provider in schema.prisma for Postgres.
DATABASE_URL="file:./dev.db"

# Admin login for /admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"

# Secret used to sign the admin session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32+-character-string"

# Public base URL (used for sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
