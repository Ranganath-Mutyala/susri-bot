{
  "name": "clearcompare-affiliate-site",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-niche affiliate comparison publication with admin panel (Next.js + Prisma + SQLite)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "setup": "prisma migrate deploy && prisma db seed",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:db:migrate": "wrangler d1 migrations apply wisecompare-db --remote",
    "cf:db:seed": "wrangler d1 execute wisecompare-db --remote --file seed/seed.sql",
    "cf:db:migrate:local": "wrangler d1 migrations apply wisecompare-db --local",
    "cf:db:seed:local": "wrangler d1 execute wisecompare-db --local --file seed/seed.sql",
    "deploy:cloudflare": "npm run cf:db:migrate && npm run cf:db:seed && opennextjs-cloudflare deploy",
    "seed:sql": "bash scripts/build-seed-sql.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "jose": "5.10.0",
    "marked": "15.0.12",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
